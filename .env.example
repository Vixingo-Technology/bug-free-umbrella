# ============================================================
# JKA Bangladesh — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================


# ────────────────────────────────────────────────────────────
# APP
# ────────────────────────────────────────────────────────────

# The public URL of your deployed app (used for OG tags, callbacks, QR codes)
APP_URL="http://localhost:3000"

# Next.js environment (development | production | test)
NODE_ENV="development"


# ────────────────────────────────────────────────────────────
# SUPABASE
# ────────────────────────────────────────────────────────────

# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role key — NEVER expose to the browser
# Used only in server actions / API routes
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"


# ────────────────────────────────────────────────────────────
# DATABASE (Prisma + PostgreSQL via Supabase)
# ────────────────────────────────────────────────────────────

# Pooled connection — used by Prisma at runtime (via pgBouncer)
# Found in: Supabase dashboard → Project Settings → Database → Connection string → URI
# Add ?pgbouncer=true&connection_limit=1 for serverless environments
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection — used by Prisma Migrate (bypasses pgBouncer)
# Found in: Supabase dashboard → Project Settings → Database → Connection string → URI (port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"


# ────────────────────────────────────────────────────────────
# AI
# ────────────────────────────────────────────────────────────

# Google Gemini API key — used for the AI assistant & WhatsApp bot
# Get it from: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY="your-google-ai-api-key"
GEMINI_API_KEY="your-gemini-api-key"


# ────────────────────────────────────────────────────────────
# CLOUDINARY (Media & Certificate Storage)
# ────────────────────────────────────────────────────────────

# Full Cloudinary URL — contains cloud name, API key, and secret
# Found in: Cloudinary dashboard → Settings → Access Keys
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"


# ────────────────────────────────────────────────────────────
# PAYMENTS
# ────────────────────────────────────────────────────────────

# SSLCommerz — local payment gateway (bKash, Nagad, cards)
# Get credentials from: https://developer.sslcommerz.com
SSLCOMMERZ_STORE_ID="your-sslcommerz-store-id"
SSLCOMMERZ_STORE_PASSWORD="your-sslcommerz-store-password"
# "sandbox" or "live"
SSLCOMMERZ_ENV="sandbox"

# Stripe — international payments
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."


# ────────────────────────────────────────────────────────────
# AUTOMATION (n8n on Hetzner)
# ────────────────────────────────────────────────────────────

# URL of your n8n instance
N8N_BASE_URL="https://n8n.your-domain.com"

# Shared secret for webhook signature verification
N8N_WEBHOOK_SECRET="a-long-random-string-min-32-chars"


# ────────────────────────────────────────────────────────────
# WHATSAPP BUSINESS API
# ────────────────────────────────────────────────────────────

# Meta WhatsApp Business API credentials
# Set up via: https://developers.facebook.com/docs/whatsapp
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-permanent-access-token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"


# ────────────────────────────────────────────────────────────
# MAPS (Dojo Locator)
# ────────────────────────────────────────────────────────────

# Mapbox public token — safe to expose in the browser
# Get it from: https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1IjoiLi4uIn0..."
