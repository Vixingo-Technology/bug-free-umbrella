generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}
// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum GradingResult {
  PENDING
  PASSED
  FAILED
}

enum ApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum EventType {
  TOURNAMENT
  SEMINAR
  TRAINING_CAMP
  GRADING
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  INFO
  REMINDER
  ALERT
  WELCOME
}

// ─── Identity ────────────────────────────────────────────────────────────────

model Member {
  id           String    @id @db.Uuid // Matches auth.users(id)
  fullName     String    @map("full_name")
  email        String    @unique
  phone        String?
  currentRank  String?   @map("current_rank")
  dojoId       String?   @map("dojo_id") @db.Uuid
  expiryDate   DateTime? @map("expiry_date") @db.Date
  role         Role      @default(STUDENT)
  avatarUrl    String?   @map("avatar_url")
  memberNumber String?   @unique @map("member_number")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  dojo                 Dojo?                   @relation("DojoMembers", fields: [dojoId], references: [id], onDelete: SetNull)
  headDojos            Dojo[]                  @relation("DojoHead")
  gradings             Grading[]               @relation("MemberGradings")
  gradingApplications  GradingApplication[]
  matchesAsA           TournamentMatch[]       @relation("MatchParticipantA")
  matchesAsB           TournamentMatch[]       @relation("MatchParticipantB")
  matchesWon           TournamentMatch[]       @relation("MatchWinner")
  tournamentEntries    TournamentParticipant[]
  orders               ShopOrder[]
  eventRegistrations   EventRegistration[]
  attendance           Attendance[]
  notifications        Notification[]
  instructorProfile    Instructor?

  @@map("members")
}

model Instructor {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId    String   @unique @map("member_id") @db.Uuid
  bio         String?
  speciality  String?
  yearsExp    Int?     @map("years_exp")
  photoUrl    String?  @map("photo_url")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("instructors")
}

// ─── Infrastructure ───────────────────────────────────────────────────────────

model Dojo {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  city             String
  address          String?
  division         String?
  lat              Decimal? @db.Decimal
  lng              Decimal? @db.Decimal
  headInstructorId String?  @map("head_instructor_id") @db.Uuid
  schedule         Json?
  phone            String?
  email            String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  headInstructor   Member?    @relation("DojoHead", fields: [headInstructorId], references: [id], onDelete: SetNull)
  members          Member[]   @relation("DojoMembers")
  attendance       Attendance[]

  @@map("dojos")
}

model Attendance {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  dojoId    String   @map("dojo_id") @db.Uuid
  date      DateTime @db.Date
  present   Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dojo      Dojo     @relation(fields: [dojoId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@map("attendance")
}

// ─── Ranking ─────────────────────────────────────────────────────────────────

model BeltRank {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameEn       String   @map("name_en")
  nameBn       String   @map("name_bn")
  colorHex     String   @map("color_hex")
  requiredKata String?  @map("required_kata")
  orderIndex   Int      @default(0) @map("order_index")
  kyuDan       String?  @map("kyu_dan") // e.g. "10th Kyu", "1st Dan"

  gradingsFrom         Grading[]            @relation("GradingFromRank")
  gradingsTo           Grading[]            @relation("GradingToRank")
  gradingEventsFor     GradingEvent[]
  applications         GradingApplication[]

  @@map("belt_ranks")
}

model GradingEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  eventDate     DateTime @map("event_date") @db.Date
  location      String?
  targetRankId  String?  @map("target_rank_id") @db.Uuid
  registrationDeadline DateTime? @map("registration_deadline") @db.Date
  maxCapacity   Int?     @map("max_capacity")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  targetRank    BeltRank? @relation(fields: [targetRankId], references: [id], onDelete: SetNull)
  gradings      Grading[]
  applications  GradingApplication[]

  @@map("grading_events")
}

model GradingApplication {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId       String            @map("member_id") @db.Uuid
  gradingEventId String            @map("grading_event_id") @db.Uuid
  targetRankId   String?           @map("target_rank_id") @db.Uuid
  status         ApplicationStatus @default(SUBMITTED)
  appliedAt      DateTime          @default(now()) @map("applied_at")
  notes          String?

  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gradingEvent   GradingEvent @relation(fields: [gradingEventId], references: [id], onDelete: Cascade)
  targetRank     BeltRank?    @relation(fields: [targetRankId], references: [id], onDelete: SetNull)

  @@unique([memberId, gradingEventId])
  @@map("grading_applications")
}

model Grading {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId       String         @map("member_id") @db.Uuid
  fromRankId     String?        @map("from_rank_id") @db.Uuid
  toRankId       String?        @map("to_rank_id") @db.Uuid
  gradingEventId String?        @map("grading_event_id") @db.Uuid
  result         GradingResult  @default(PENDING)
  certificateUrl String?        @map("certificate_url")
  qrCode         String?        @map("qr_code")
  gradedAt       DateTime?      @map("graded_at") @db.Date
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  member         Member        @relation("MemberGradings", fields: [memberId], references: [id], onDelete: Cascade)
  fromRank       BeltRank?     @relation("GradingFromRank", fields: [fromRankId], references: [id], onDelete: SetNull)
  toRank         BeltRank?     @relation("GradingToRank", fields: [toRankId], references: [id], onDelete: SetNull)
  gradingEvent   GradingEvent? @relation(fields: [gradingEventId], references: [id], onDelete: SetNull)

  @@map("gradings")
}

// ─── Competition ─────────────────────────────────────────────────────────────

model Tournament {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  location    String?
  eventDate   DateTime @map("event_date") @db.Date
  isActive    Boolean  @default(true) @map("is_active")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  participants TournamentParticipant[]
  matches      TournamentMatch[]

  @@map("tournaments")
}

model TournamentParticipant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId  String   @map("tournament_id") @db.Uuid
  memberId      String   @map("member_id") @db.Uuid
  category      String?  // e.g. "Kata - Senior Male"
  seedNumber    Int?     @map("seed_number")
  registeredAt  DateTime @default(now()) @map("registered_at")

  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  member        Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, memberId])
  @@map("tournament_participants")
}

model TournamentMatch {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId   String? @map("tournament_id") @db.Uuid
  round          Int?    @default(1)
  participantAId String  @map("participant_a_id") @db.Uuid
  participantBId String  @map("participant_b_id") @db.Uuid
  winnerId       String? @map("winner_id") @db.Uuid
  scoreA         String? @map("score_a")
  scoreB         String? @map("score_b")
  completedAt    DateTime? @map("completed_at")

  tournament     Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  participantA   Member      @relation("MatchParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB   Member      @relation("MatchParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  winner         Member?     @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@map("tournament_matches")
}

// ─── Content ─────────────────────────────────────────────────────────────────

model Event {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleEn      String    @map("title_en")
  titleBn      String?   @map("title_bn")
  descriptionEn String?  @map("description_en")
  descriptionBn String?  @map("description_bn")
  eventType    EventType @default(OTHER) @map("event_type")
  eventDate    DateTime  @map("event_date")
  location     String?
  maxCapacity  Int?      @map("max_capacity")
  imageUrl     String?   @map("image_url")
  isPublished  Boolean   @default(false) @map("is_published")
  registrationOpen Boolean @default(false) @map("registration_open")
  registrationDeadline DateTime? @map("registration_deadline")
  createdAt    DateTime  @default(now()) @map("created_at")

  registrations EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  registeredAt DateTime @default(now()) @map("registered_at")
  notes      String?

  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@map("event_registrations")
}

model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId   String           @map("member_id") @db.Uuid
  type       NotificationType @default(INFO)
  title      String
  message    String
  isRead     Boolean          @default(false) @map("is_read")
  actionUrl  String?          @map("action_url")
  createdAt  DateTime         @default(now()) @map("created_at")

  member     Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── E-commerce ──────────────────────────────────────────────────────────────

model ShopProduct {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameEn      String   @map("name_en")
  nameBn      String?  @map("name_bn")
  description String?
  priceBdt    Decimal  @map("price_bdt") @db.Decimal
  imageUrl    String?  @map("image_url")
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")

  orderItems  ShopOrderItem[]

  @@map("shop_products")
}

model ShopOrder {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId      String        @map("member_id") @db.Uuid
  totalBdt      Decimal       @map("total_bdt") @db.Decimal
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  itemsJson     Json          @map("items_json")
  txnRef        String?       @map("txn_ref")
  paymentMethod String?       @map("payment_method")
  shippingAddress String?     @map("shipping_address")
  createdAt     DateTime      @default(now()) @map("created_at")

  member        Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  orderItems    ShopOrderItem[]

  @@map("shop_orders")
}

model ShopOrderItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal

  order       ShopOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     ShopProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("shop_order_items")
}
