// =============================================================
// JKA Bangladesh — Prisma Schema
// PostgreSQL via Supabase · Prisma 7 · driverAdapters preview
//
// Naming convention:
//   - Prisma fields  → camelCase  (TypeScript client)
//   - DB columns     → snake_case (via @map)
//   - DB tables      → snake_case (via @@map)
// =============================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../prisma/generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum MemberRole {
  STUDENT
  INSTRUCTOR
  DOJO_MANAGER
  DOJO_OWNER
  ADMIN
}

enum MembershipStatus {
  PENDING   // Registered but has not paid
  ACTIVE    // Paid and active member
  EXPIRED   // Membership lapsed
  SUSPENDED // Admin-suspended
}

enum GradingResult {
  PASSED
  FAILED
  ABSENT
}

enum ApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  PAYMENT
  GRADING
  EVENT
  RENEWAL
}

// ─────────────────────────────────────────────
// BELT RANKS
// ─────────────────────────────────────────────

model BeltRank {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String  @unique
  nameBn     String? @map("name_bn")
  kyuDan     String? @map("kyu_dan")
  colorHex   String? @map("color_hex")
  orderIndex Int     @unique @map("order_index")

  gradingsFrom        Grading[]            @relation("GradingFromRank")
  gradingsTo          Grading[]            @relation("GradingToRank")
  gradingEvents       GradingEvent[]       @relation("EventTargetRank")
  gradingApplications GradingApplication[] @relation("AppTargetRank")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("belt_ranks")
}

// ─────────────────────────────────────────────
// DOJOS
// ─────────────────────────────────────────────

model Dojo {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  address           String?
  city              String?
  latitude          Float?
  longitude         Float?
  phone             String?
  email             String?
  schedule          Json?
  isActive          Boolean @default(true) @map("is_active")

  // The dojo head is the Member with role = DOJO_OWNER and dojoId = this.id.
  // A partial unique index `members_one_owner_per_dojo` enforces "at most one
  // owner per dojo" at the DB level (see scripts/migrations/2026-06-24-...sql).
  members        Member[]     @relation("DojoMembers")
  attendance     Attendance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("dojos")
}

// ─────────────────────────────────────────────
// DOJO ENLISTMENT APPLICATIONS
// Filed by dojo owners via /enlist-dojo. Stored as a separate
// table from `dojos` so federation staff can review before a
// public branch listing is created.
// ─────────────────────────────────────────────

enum DojoApplicationStatus {
  PENDING_PAYMENT
  PAID
  APPROVED
  REJECTED
}

model DojoApplication {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String? @db.Uuid @map("user_id") // Supabase auth.users id of the owner

  dojoName    String  @map("dojo_name")
  logoUrl     String? @map("logo_url")
  email       String
  phone       String
  contactName String  @map("contact_name")
  contactRole String  @map("contact_role")

  address   String
  latitude  Float?
  longitude Float?

  interiorUrls String[] @default([]) @map("interior_urls")
  trainers     Json     @default("[]")

  status    DojoApplicationStatus @default(PENDING_PAYMENT)
  paymentId String?               @map("payment_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("dojo_applications")
}

// ─────────────────────────────────────────────
// MEMBERS  (mirrors auth.users via id)
// ─────────────────────────────────────────────

model Member {
  id                   String           @id @db.Uuid           // = auth.users.id
  fullName             String           @map("full_name")
  email                String           @unique
  phone                String?
  avatarUrl            String?          @map("avatar_url")
  role                 MemberRole       @default(STUDENT)
  memberNumber         String?          @unique @map("member_number")
  currentRank          String           @default("White Belt") @map("current_rank")
  joinDate             DateTime         @default(now())        @map("join_date")
  expiryDate           DateTime?        @map("expiry_date")
  isActive             Boolean          @default(true)         @map("is_active")
  dojoId               String?          @db.Uuid               @map("dojo_id")

  // Onboarding & membership status
  onboardingComplete   Boolean          @default(false)        @map("onboarding_complete")
  membershipStatus     MembershipStatus @default(PENDING)      @map("membership_status")

  // Extended profile (collected during onboarding)
  dateOfBirth          DateTime?        @map("date_of_birth")  @db.Date
  bloodGroup           String?          @map("blood_group")
  address              String?
  nationalId           String?          @map("national_id")
  emergencyContactName String?          @map("emergency_contact_name")
  emergencyContactPhone String?         @map("emergency_contact_phone")

  dojo                 Dojo?                   @relation("DojoMembers", fields: [dojoId], references: [id])
  gradings             Grading[]
  gradingApplications  GradingApplication[]
  eventRegistrations   EventRegistration[]
  notifications        Notification[]
  orders               ShopOrder[]
  attendance           Attendance[]
  tournamentEntries    TournamentParticipant[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("members")
}

// ─────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────

model Attendance {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId String   @db.Uuid @map("member_id")
  dojoId   String?  @db.Uuid @map("dojo_id")
  date     DateTime @db.Date
  present  Boolean  @default(true)
  notes    String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dojo   Dojo?  @relation(fields: [dojoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([memberId, date])
  @@map("attendance")
}

// ─────────────────────────────────────────────
// GRADING EVENTS
// ─────────────────────────────────────────────

model GradingEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  eventDate    DateTime @map("event_date")
  location     String?
  targetRankId String?  @db.Uuid @map("target_rank_id")
  isOpen       Boolean  @default(true) @map("is_open")
  notes        String?

  targetRank   BeltRank?            @relation("EventTargetRank", fields: [targetRankId], references: [id])
  gradings     Grading[]
  applications GradingApplication[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("grading_events")
}

// ─────────────────────────────────────────────
// GRADING APPLICATIONS
// ─────────────────────────────────────────────

model GradingApplication {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId       String            @db.Uuid @map("member_id")
  gradingEventId String?           @db.Uuid @map("grading_event_id")
  targetRankId   String?           @db.Uuid @map("target_rank_id")
  status         ApplicationStatus @default(SUBMITTED)
  notes          String?
  declineReason  String?           @map("decline_reason")
  appliedAt      DateTime          @default(now()) @map("applied_at")

  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gradingEvent GradingEvent? @relation(fields: [gradingEventId], references: [id], onDelete: Cascade)
  targetRank   BeltRank?     @relation("AppTargetRank", fields: [targetRankId], references: [id])

  // Uniqueness is enforced at the DB level by two partial indexes (see
  // scripts/migrations/2026-06-24-belt-test-requests.sql):
  //   - one_pending_request_per_member  (when grading_event_id IS NULL)
  //   - one_app_per_member_per_event    (when grading_event_id IS NOT NULL)

  @@index([memberId])
  @@index([gradingEventId])
  @@map("grading_applications")
}

// ─────────────────────────────────────────────
// GRADINGS
// ─────────────────────────────────────────────

model Grading {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId       String        @db.Uuid @map("member_id")
  gradingEventId String?       @db.Uuid @map("grading_event_id")
  fromRankId     String?       @db.Uuid @map("from_rank_id")
  toRankId       String?       @db.Uuid @map("to_rank_id")
  result         GradingResult @default(PASSED)
  certificateUrl String?       @map("certificate_url")
  notes          String?

  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gradingEvent GradingEvent? @relation(fields: [gradingEventId], references: [id])
  fromRank     BeltRank?     @relation("GradingFromRank", fields: [fromRankId], references: [id])
  toRank       BeltRank?     @relation("GradingToRank", fields: [toRankId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("gradings")
}

// ─────────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────────

model Event {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  eventDate   DateTime @map("event_date")
  location    String?
  imageUrl    String?  @map("image_url")
  isPublished Boolean  @default(false) @map("is_published")
  maxCapacity Int?     @map("max_capacity")

  registrations EventRegistration[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("events")
}

// ─────────────────────────────────────────────
// EVENT REGISTRATIONS
// ─────────────────────────────────────────────

model EventRegistration {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId  String @db.Uuid @map("event_id")
  memberId String @db.Uuid @map("member_id")

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, memberId])
  @@map("event_registrations")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId String           @db.Uuid @map("member_id")
  title    String
  message  String
  type     NotificationType @default(INFO)
  isRead   Boolean          @default(false) @map("is_read")
  link     String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("notifications")
}

// ─────────────────────────────────────────────
// SHOP PRODUCTS
// ─────────────────────────────────────────────

model ShopProduct {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  stock       Int     @default(0)
  imageUrl    String? @map("image_url")
  category    String? // e.g. "gear", "apparel", "equipment"
  isActive    Boolean @default(true) @map("is_active")

  orderItems ShopOrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("shop_products")
}

// ─────────────────────────────────────────────
// SHOP ORDERS
// ─────────────────────────────────────────────

model ShopOrder {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId            String        @db.Uuid @map("member_id")
  paymentStatus       PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod       String?       @map("payment_method")
  total               Decimal       @db.Decimal(10, 2)
  currency            String        @default("BDT")
  transactionId       String?       @unique @map("transaction_id")
  includesMembership  Boolean       @default(false) @map("includes_membership") // onboarding orders include the membership fee
  membershipFee       Decimal?      @db.Decimal(10, 2) @map("membership_fee")
  notes               String?

  member     Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  orderItems ShopOrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("shop_orders")
}

// ─────────────────────────────────────────────
// SHOP ORDER ITEMS
// ─────────────────────────────────────────────

model ShopOrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @db.Uuid @map("order_id")
  productId String  @db.Uuid @map("product_id")
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2) @map("unit_price")

  order   ShopOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ShopProduct @relation(fields: [productId], references: [id])

  @@map("shop_order_items")
}

// ─────────────────────────────────────────────
// TOURNAMENTS
// ─────────────────────────────────────────────

model Tournament {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  date        DateTime
  location    String?
  isPublished Boolean  @default(false) @map("is_published")

  participants TournamentParticipant[]
  matches      TournamentMatch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("tournaments")
}

// ─────────────────────────────────────────────
// TOURNAMENT PARTICIPANTS
// ─────────────────────────────────────────────

model TournamentParticipant {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId String  @db.Uuid @map("tournament_id")
  memberId     String  @db.Uuid @map("member_id")
  category     String?
  weightClass  String? @map("weight_class")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  matchesAsP1 TournamentMatch[] @relation("MatchParticipant1")
  matchesAsP2 TournamentMatch[] @relation("MatchParticipant2")
  matchesWon  TournamentMatch[] @relation("MatchWinner")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tournamentId, memberId])
  @@map("tournament_participants")
}

// ─────────────────────────────────────────────
// TOURNAMENT MATCHES
// ─────────────────────────────────────────────

model TournamentMatch {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId   String  @db.Uuid  @map("tournament_id")
  participant1Id String? @db.Uuid  @map("participant1_id")
  participant2Id String? @db.Uuid  @map("participant2_id")
  winnerId       String? @db.Uuid  @map("winner_id")
  round          Int?
  matchOrder     Int?    @map("match_order")
  notes          String?

  tournament   Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant1 TournamentParticipant? @relation("MatchParticipant1", fields: [participant1Id], references: [id])
  participant2 TournamentParticipant? @relation("MatchParticipant2", fields: [participant2Id], references: [id])
  winner       TournamentParticipant? @relation("MatchWinner", fields: [winnerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("tournament_matches")
}
