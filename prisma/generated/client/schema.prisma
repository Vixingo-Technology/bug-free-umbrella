// =============================================================
// JKA Bangladesh — Prisma Schema
// PostgreSQL via Supabase · Prisma 7 · driverAdapters preview
//
// Naming convention:
//   - Prisma fields  → camelCase  (TypeScript client)
//   - DB columns     → snake_case (via @map)
//   - DB tables      → snake_case (via @@map)
// =============================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../prisma/generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum MemberRole {
  STUDENT
  INSTRUCTOR
  DOJO_MANAGER
  DOJO_OWNER
  ADMIN
}

enum MembershipStatus {
  PENDING // Registered but has not paid
  ACTIVE // Paid and active member
  EXPIRED // Membership lapsed
  SUSPENDED // Admin-suspended
}

enum GradingResult {
  PASSED
  FAILED
  ABSENT
}

enum ApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  PAYMENT
  GRADING
  EVENT
  RENEWAL
  CERTIFICATE
}

enum CertificateRequestStatus {
  PENDING_PAYMENT
  PAID
  GENERATING
  ISSUED
  FAILED
}

enum EventCategory {
  BELT_TEST
  TOURNAMENT
  SEMINAR
  TRAINING_CAMP
  OTHER
}

enum AttachmentType {
  IMAGE
  PDF
}

// ─────────────────────────────────────────────
// BELT RANKS
// ─────────────────────────────────────────────

model BeltRank {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String  @unique
  kyuDan     String? @map("kyu_dan")
  colorHex   String? @map("color_hex")
  orderIndex Int     @unique @map("order_index")

  // Certificate fee for this rank (BDT). Dojo pays this when requesting a
  // printed certificate. Null/0 means no charge for this rank.
  certificatePrice Decimal? @map("certificate_price") @db.Decimal(10, 2)

  gradingsFrom        Grading[]            @relation("GradingFromRank")
  gradingsTo          Grading[]            @relation("GradingToRank")
  gradingEvents       GradingEvent[]       @relation("EventTargetRank")
  gradingApplications GradingApplication[] @relation("AppTargetRank")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("belt_ranks")
}

// ─────────────────────────────────────────────
// DOJOS
// ─────────────────────────────────────────────

model Dojo {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  address   String?
  city      String?
  latitude  Float?
  longitude Float?
  phone     String?
  email     String?
  schedule  Json?
  isActive  Boolean @default(true) @map("is_active")

  // Renewal — dojos pay an annual federation fee, mirrors how members renew.
  annualFee  Decimal?  @map("annual_fee") @db.Decimal(10, 2)
  expiryDate DateTime? @map("expiry_date")

  // Renewal orders placed by the DOJO_OWNER for this dojo.
  renewalOrders ShopOrder[] @relation("DojoRenewalOrders")

  // Certificate orders + cert requests originated by this dojo.
  certificateOrders   ShopOrder[]          @relation("DojoCertificateOrders")
  certificateRequests CertificateRequest[]

  // Cloudinary URL of the dojo owner's signature (PNG with transparent bg).
  // Required before the dojo can place a certificate order.
  ownerSignatureUrl String? @map("owner_signature_url")

  // Cloudinary URL of the dojo logo (PNG or SVG, transparent background).
  logoUrl String? @map("logo_url")

  // The dojo head is the Member with role = DOJO_OWNER and dojoId = this.id.
  // A partial unique index `members_one_owner_per_dojo` enforces "at most one
  // owner per dojo" at the DB level (see scripts/migrations/2026-06-24-...sql).
  members       Member[]       @relation("DojoMembers")
  attendance    Attendance[]
  events        Event[]        @relation("DojoEvents")
  announcements Announcement[] @relation("DojoAnnouncements")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dojos")
}

// ─────────────────────────────────────────────
// DOJO ENLISTMENT APPLICATIONS
// Filed by dojo owners via /enlist-dojo. Stored as a separate
// table from `dojos` so federation staff can review before a
// public branch listing is created.
// ─────────────────────────────────────────────

enum DojoApplicationStatus {
  PENDING_PAYMENT
  PAID
  APPROVED
  REJECTED
}

model DojoApplication {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String? @map("user_id") @db.Uuid // Supabase auth.users id of the owner

  dojoName    String  @map("dojo_name")
  logoUrl     String? @map("logo_url")
  email       String
  phone       String
  contactName String  @map("contact_name")
  contactRole String  @map("contact_role")

  address   String
  latitude  Float?
  longitude Float?

  interiorUrls String[] @default([]) @map("interior_urls")
  trainers     Json     @default("[]")

  status    DojoApplicationStatus @default(PENDING_PAYMENT)
  paymentId String?               @map("payment_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("dojo_applications")
}

// ─────────────────────────────────────────────
// MEMBERS  (mirrors auth.users via id)
// ─────────────────────────────────────────────

model Member {
  id           String     @id @db.Uuid // = auth.users.id
  fullName     String     @map("full_name")
  email        String     @unique
  phone        String?
  avatarUrl    String?    @map("avatar_url")
  role         MemberRole @default(STUDENT)
  memberNumber String?    @unique @map("member_number")
  currentRank  String     @default("White Belt") @map("current_rank")
  joinDate     DateTime   @default(now()) @map("join_date")
  expiryDate   DateTime?  @map("expiry_date")
  isActive     Boolean    @default(true) @map("is_active")
  dojoId       String?    @map("dojo_id") @db.Uuid

  // Onboarding & membership status
  onboardingComplete Boolean          @default(false) @map("onboarding_complete")
  membershipStatus   MembershipStatus @default(PENDING) @map("membership_status")

  // Extended profile (collected during onboarding)
  dateOfBirth           DateTime? @map("date_of_birth") @db.Date
  bloodGroup            String?   @map("blood_group")
  address               String?
  nationalId            String?   @map("national_id")
  fatherName            String?   @map("father_name")
  motherName            String?   @map("mother_name")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")

  dojo                Dojo?                   @relation("DojoMembers", fields: [dojoId], references: [id])
  gradings            Grading[]
  gradingApplications GradingApplication[]
  eventRegistrations  EventRegistration[]
  notifications       Notification[]
  orders              ShopOrder[]
  attendance          Attendance[]
  tournamentEntries   TournamentParticipant[]
  certificateRequests CertificateRequest[]
  eventsPosted        Event[]                 @relation("EventsPosted")
  announcementsPosted Announcement[]          @relation("AnnouncementsPosted")
  eventCheckIns       EventRegistration[]     @relation("EventCheckIns")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("members")
}

// ─────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────

model Attendance {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId String   @map("member_id") @db.Uuid
  dojoId   String?  @map("dojo_id") @db.Uuid
  date     DateTime @db.Date
  present  Boolean  @default(true)
  notes    String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dojo   Dojo?  @relation(fields: [dojoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([memberId, date])
  @@map("attendance")
}

// ─────────────────────────────────────────────
// GRADING EVENTS
// ─────────────────────────────────────────────

model GradingEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  eventDate    DateTime @map("event_date")
  location     String?
  targetRankId String?  @map("target_rank_id") @db.Uuid
  isOpen       Boolean  @default(true) @map("is_open")
  notes        String?

  // Soft-cancel: a cancelled event keeps its row + Grading children for audit,
  // but applications flip to CANCELLED and no further results may be drafted.
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  // Results lifecycle: Grading rows exist as soon as the dojo drafts them,
  // but stay hidden from students until resultsPublishedAt is set.
  resultsPublishedAt DateTime? @map("results_published_at")

  targetRank   BeltRank?            @relation("EventTargetRank", fields: [targetRankId], references: [id])
  gradings     Grading[]
  applications GradingApplication[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("grading_events")
}

// ─────────────────────────────────────────────
// GRADING APPLICATIONS
// ─────────────────────────────────────────────

model GradingApplication {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId       String            @map("member_id") @db.Uuid
  gradingEventId String?           @map("grading_event_id") @db.Uuid
  targetRankId   String?           @map("target_rank_id") @db.Uuid
  status         ApplicationStatus @default(SUBMITTED)
  notes          String?
  declineReason  String?           @map("decline_reason")
  appliedAt      DateTime          @default(now()) @map("applied_at")

  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gradingEvent GradingEvent? @relation(fields: [gradingEventId], references: [id], onDelete: Cascade)
  targetRank   BeltRank?     @relation("AppTargetRank", fields: [targetRankId], references: [id])

  // Uniqueness is enforced at the DB level by two partial indexes (see
  // scripts/migrations/2026-06-24-belt-test-requests.sql):
  //   - one_pending_request_per_member  (when grading_event_id IS NULL)
  //   - one_app_per_member_per_event    (when grading_event_id IS NOT NULL)

  @@index([memberId])
  @@index([gradingEventId])
  @@map("grading_applications")
}

// ─────────────────────────────────────────────
// GRADINGS
// ─────────────────────────────────────────────

model Grading {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId       String        @map("member_id") @db.Uuid
  gradingEventId String?       @map("grading_event_id") @db.Uuid
  fromRankId     String?       @map("from_rank_id") @db.Uuid
  toRankId       String?       @map("to_rank_id") @db.Uuid
  result         GradingResult @default(PASSED)
  certificateUrl String?       @map("certificate_url")
  notes          String?

  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gradingEvent GradingEvent? @relation(fields: [gradingEventId], references: [id])
  fromRank     BeltRank?     @relation("GradingFromRank", fields: [fromRankId], references: [id])
  toRank       BeltRank?     @relation("GradingToRank", fields: [toRankId], references: [id])

  certificateRequests CertificateRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("gradings")
}

// ─────────────────────────────────────────────
// CERTIFICATE REQUESTS
// Dojo-initiated: dojo selects passed gradings, pays the per-rank fee,
// and the system renders and stores the PDF certificate.
// ─────────────────────────────────────────────

model CertificateRequest {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gradingId      String                   @map("grading_id") @db.Uuid
  memberId       String                   @map("member_id") @db.Uuid
  dojoId         String                   @map("dojo_id") @db.Uuid
  orderId        String?                  @map("order_id") @db.Uuid
  status         CertificateRequestStatus @default(PENDING_PAYMENT)
  price          Decimal                  @db.Decimal(10, 2)
  certificateUrl String?                  @map("certificate_url")
  failureReason  String?                  @map("failure_reason")

  // Snapshotted at request time so a later rename of the member does not
  // mutate an already-issued certificate.
  memberName String  @map("member_name")
  fatherName String? @map("father_name")
  motherName String? @map("mother_name")
  rankName   String  @map("rank_name")

  grading Grading    @relation(fields: [gradingId], references: [id], onDelete: Cascade)
  member  Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dojo    Dojo       @relation(fields: [dojoId], references: [id])
  order   ShopOrder? @relation("OrderCertificates", fields: [orderId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // One issued certificate per grading. PENDING_PAYMENT rows are deduped
  // at the SQL layer with a partial unique index so retries don't pile up.
  @@index([gradingId])
  @@index([dojoId])
  @@index([orderId])
  @@index([status])
  @@map("certificate_requests")
}

// ─────────────────────────────────────────────
// SYSTEM SETTINGS — singleton row (id = "default")
// Stores federation-wide configuration like the admin signature URL.
// ─────────────────────────────────────────────

model SystemSettings {
  id                 String  @id @default("default")
  adminSignatureUrl  String? @map("admin_signature_url")
  adminSignerName    String? @map("admin_signer_name")
  adminSignerTitle   String? @map("admin_signer_title")
  certificateLogoUrl String? @map("certificate_logo_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ─────────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────────

model Event {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  eventDate   DateTime      @map("event_date")
  location    String?
  imageUrl    String?       @map("image_url")
  isPublished Boolean       @default(false) @map("is_published")
  maxCapacity Int?          @map("max_capacity")
  category    EventCategory @default(OTHER)

  // Optional attachment (PDF brochure or image flyer) shown on the detail page.
  attachmentUrl  String?         @map("attachment_url")
  attachmentType AttachmentType? @map("attachment_type")

  // Who posted this event. Either ADMIN (federation-wide) or DOJO_OWNER (dojo-scoped).
  postedById String? @map("posted_by_id") @db.Uuid
  dojoId     String? @map("dojo_id") @db.Uuid

  registrations EventRegistration[]
  postedBy      Member?             @relation("EventsPosted", fields: [postedById], references: [id])
  dojo          Dojo?               @relation("DojoEvents", fields: [dojoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isPublished, eventDate])
  @@index([category])
  @@map("events")
}

// ─────────────────────────────────────────────
// ANNOUNCEMENTS
// Short text posts shown on the landing page Announcements tab.
// Only ADMIN (federation-wide) and DOJO_OWNER (dojo-scoped) can post.
// ─────────────────────────────────────────────

model Announcement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  body        String?
  link        String?
  isPublished Boolean  @default(true) @map("is_published")
  publishedAt DateTime @default(now()) @map("published_at")

  // Optional attachment (PDF or image) shown on the detail page.
  attachmentUrl  String?         @map("attachment_url")
  attachmentType AttachmentType? @map("attachment_type")

  postedById String? @map("posted_by_id") @db.Uuid
  dojoId     String? @map("dojo_id") @db.Uuid

  postedBy Member? @relation("AnnouncementsPosted", fields: [postedById], references: [id])
  dojo     Dojo?   @relation("DojoAnnouncements", fields: [dojoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isPublished, publishedAt])
  @@map("announcements")
}

// ─────────────────────────────────────────────
// EVENT REGISTRATIONS
// ─────────────────────────────────────────────

model EventRegistration {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  // memberId is set when a signed-in member registers; null for public/guest
  // registrations, in which case the guest_* fields capture the participant.
  memberId   String? @map("member_id") @db.Uuid
  guestName  String? @map("guest_name")
  guestEmail String? @map("guest_email")
  guestPhone String? @map("guest_phone")

  // Random URL-safe token embedded in the participant's QR code. Opening
  // /check-in/[qrToken] as an authorised admin / dojo owner marks them present.
  qrToken String @unique @map("qr_token")

  // Check-in state. Set the moment an authority opens the QR URL.
  checkedInAt   DateTime? @map("checked_in_at")
  checkedInById String?   @map("checked_in_by_id") @db.Uuid

  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member      Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkedInBy Member? @relation("EventCheckIns", fields: [checkedInById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  // Uniqueness is enforced at the DB level via two partial indexes:
  //   one_registration_per_member_per_event  (when member_id IS NOT NULL)
  //   one_guest_registration_per_event       (when member_id IS NULL,
  //                                           keyed on guest_email)
  @@index([eventId, checkedInAt])
  @@map("event_registrations")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId String           @map("member_id") @db.Uuid
  title    String
  message  String
  type     NotificationType @default(INFO)
  isRead   Boolean          @default(false) @map("is_read")
  link     String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notifications")
}

// ─────────────────────────────────────────────
// SHOP PRODUCTS
// ─────────────────────────────────────────────

model ShopProduct {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  stock       Int     @default(0)
  imageUrl    String? @map("image_url")
  category    String? // e.g. "gear", "apparel", "equipment"
  isActive    Boolean @default(true) @map("is_active")

  orderItems ShopOrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shop_products")
}

// ─────────────────────────────────────────────
// SHOP ORDERS
// ─────────────────────────────────────────────

model ShopOrder {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId           String        @map("member_id") @db.Uuid
  paymentStatus      PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod      String?       @map("payment_method")
  total              Decimal       @db.Decimal(10, 2)
  currency           String        @default("BDT")
  transactionId      String?       @unique @map("transaction_id")
  includesMembership Boolean       @default(false) @map("includes_membership") // onboarding orders include the membership fee
  membershipFee      Decimal?      @map("membership_fee") @db.Decimal(10, 2)
  notes              String?

  // Dojo renewal: when set, this order extends dojo.expiryDate on payment.
  dojoId              String? @map("dojo_id") @db.Uuid
  includesDojoRenewal Boolean @default(false) @map("includes_dojo_renewal")

  // Certificate orders: a dojo bundles N cert requests into one order.
  // When set, dojoCertOrderId distinguishes from renewal orders that
  // also reference dojoId.
  includesCertificates Boolean @default(false) @map("includes_certificates")
  certDojoId           String? @map("cert_dojo_id") @db.Uuid

  member              Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dojo                Dojo?                @relation("DojoRenewalOrders", fields: [dojoId], references: [id])
  certDojo            Dojo?                @relation("DojoCertificateOrders", fields: [certDojoId], references: [id])
  orderItems          ShopOrderItem[]
  certificateRequests CertificateRequest[] @relation("OrderCertificates")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shop_orders")
}

// ─────────────────────────────────────────────
// SHOP ORDER ITEMS
// ─────────────────────────────────────────────

model ShopOrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  order   ShopOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ShopProduct @relation(fields: [productId], references: [id])

  @@map("shop_order_items")
}

// ─────────────────────────────────────────────
// TOURNAMENTS
// ─────────────────────────────────────────────

model Tournament {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  date        DateTime
  location    String?
  isPublished Boolean  @default(false) @map("is_published")

  participants TournamentParticipant[]
  matches      TournamentMatch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tournaments")
}

// ─────────────────────────────────────────────
// TOURNAMENT PARTICIPANTS
// ─────────────────────────────────────────────

model TournamentParticipant {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId String  @map("tournament_id") @db.Uuid
  memberId     String  @map("member_id") @db.Uuid
  category     String?
  weightClass  String? @map("weight_class")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  matchesAsP1 TournamentMatch[] @relation("MatchParticipant1")
  matchesAsP2 TournamentMatch[] @relation("MatchParticipant2")
  matchesWon  TournamentMatch[] @relation("MatchWinner")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tournamentId, memberId])
  @@map("tournament_participants")
}

// ─────────────────────────────────────────────
// TOURNAMENT MATCHES
// ─────────────────────────────────────────────

model TournamentMatch {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId   String  @map("tournament_id") @db.Uuid
  participant1Id String? @map("participant1_id") @db.Uuid
  participant2Id String? @map("participant2_id") @db.Uuid
  winnerId       String? @map("winner_id") @db.Uuid
  round          Int?
  matchOrder     Int?    @map("match_order")
  notes          String?

  tournament   Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant1 TournamentParticipant? @relation("MatchParticipant1", fields: [participant1Id], references: [id])
  participant2 TournamentParticipant? @relation("MatchParticipant2", fields: [participant2Id], references: [id])
  winner       TournamentParticipant? @relation("MatchWinner", fields: [winnerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("tournament_matches")
}
