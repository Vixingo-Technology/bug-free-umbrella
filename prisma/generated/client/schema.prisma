// =============================================================
// JKA Bangladesh — Prisma Schema (3NF, role-normalized)
// PostgreSQL via Supabase · Prisma 7 · driverAdapters preview
//
// Identity is split across:
//   users               — shared profile (mirrors auth.users)
//   roles               — RBAC role catalog (PK = slug)
//   permissions         — permission catalog
//   role_permissions    — M2M role↔permission
//   students            — student-specific profile (1:1 with users)
//   instructors         — instructor-specific profile (1:1 with users)
//   dojo_managers       — dojo manager profile  (1:1 with users)
//   dojo_owners         — dojo owner profile    (1:1 with users)
//   admins              — admin profile         (1:1 with users)
//
// Each role-specific table has id = users.id (PK + FK). A user has
// exactly one row in `users` and one row in the matching role table.
//
// Naming convention:
//   - Prisma fields  → camelCase  (TypeScript client)
//   - DB columns     → snake_case (via @map)
//   - DB tables      → snake_case (via @@map)
// =============================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../prisma/generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum MembershipStatus {
  PENDING // Registered but has not paid
  ACTIVE // Paid and active member
  EXPIRED // Membership lapsed
  SUSPENDED // Admin-suspended
}

// Multi-step joining flow for new students. Independent of MembershipStatus
// (which tracks whether the annual JKA fee is currently in good standing).
enum JoinStage {
  FEE_UNPAID // Step 1: pay JKA membership fee
  AWAITING_APPROVAL // Step 2: dojo owner accepts + confirms rank
  PAST_BELT_UNPAID // Step 3: pay for previous belts (non-white only)
  JOINED // Step 4: complete — full portal access
}

enum GradingResult {
  PASSED
  FAILED
  ABSENT
}

// Post-publish pipeline stage for a PASSED grading. Non-passed rows stay at
// QUALIFIED but never advance — only passes reach the manager/dojo-head steps.
enum GradingPipelineStage {
  QUALIFIED // Passed & published — awaits Manager background/dues verification
  VERIFIED // Manager verified — awaits Dojo Head submission to JKA HQ
  SUBMITTED // Sent to federation — awaits certificate issuance
}

enum ApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Payment lifecycle for the transaction log.
enum PaymentTransactionStatus {
  PENDING // Order created, buyer redirected to gateway
  SUCCESS // Gateway validated the payment
  FAILED // Gateway rejected the payment
  CANCELLED // Buyer cancelled before paying
}

// What the payment was for — lets admins group by revenue stream.
enum PaymentTransactionKind {
  MEMBERSHIP // First JKA membership fee or renewal
  PAST_BELT_FEE // Catch-up fee during joining
  CERTIFICATES // Batch of printed grading certificates
  DOJO_RENEWAL // Federation membership for a dojo
  TRANSFER // Student dojo transfer fee
  SERVICE_REQUEST // Kyu/Dan conversion or other admin-added services
  EVENT_TICKET // Event registration
  SHOP // Shop merchandise
  OTHER // Anything not otherwise classified
}

// Provider that handled the transaction.
enum PaymentProvider {
  SSLCOMMERZ
  DEV_BYPASS
  MANUAL
}

enum ShopFulfillmentStatus {
  PREPARING
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  PAYMENT
  GRADING
  EVENT
  RENEWAL
  CERTIFICATE
  TRANSFER
  SERVICE
}

enum StudentTransferStatus {
  PENDING_PAYMENT
  AWAITING_DOJO
  AWAITING_ADMIN
  AWAITING_NEW_DOJO
  APPROVED
  DENIED
  CANCELLED
}

enum StudentTransferDojoDecision {
  PENDING
  APPROVED
  REJECTED
}

// Generic service-request workflow (currently used for Kyu/Dan Conversion
// and any custom services the admin adds — Transfer Dojo has its own
// dedicated request model above).
enum ServiceRequestStatus {
  PENDING_PAYMENT
  AWAITING_DOJO
  AWAITING_ADMIN
  APPROVED
  DENIED
  CANCELLED
}

enum ServiceRequestDojoDecision {
  PENDING
  APPROVED
  REJECTED
}

enum CertificateRequestStatus {
  PENDING_PAYMENT
  PAID
  GENERATING
  ISSUED
  FAILED
}

enum EventCategory {
  BELT_TEST
  TOURNAMENT
  SEMINAR
  TRAINING_CAMP
  OTHER
}

enum AttachmentType {
  IMAGE
  PDF
}

// Who is allowed to register for an event.
enum EventParticipantType {
  PUBLIC // anyone, including guests
  STUDENTS // signed-in members with the STUDENT role
  INSTRUCTORS // signed-in members with the INSTRUCTOR role
  PARENTS // guardians of a registered student (child member number required)
  DOJO_MEMBERS // signed-in members of the event's dojo

  @@map("event_participant_type")
}

enum AchievementTier {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum AchievementRule {
  MANUAL
  ATTENDANCE_COUNT
  CONSECUTIVE_ATTENDANCE
  GRADINGS_PASSED
  EVENTS_ATTENDED
  TOURNAMENTS_PARTICIPATED
  TOURNAMENT_WINS
  CERTIFICATES_EARNED
  HIGH_MARK_GRADINGS
}

// Tournament competition type — matches the two appendices in the JKA
// tournament rulebook. Set on TournamentDetail when an Event's category is
// TOURNAMENT.
enum TournamentEventType {
  KATA
  KUMITE

  @@map("tournament_event_type")
}

// Binary sport-category gender for competition division matching. Independent
// of any wider identity signal we may capture elsewhere.
enum Gender {
  MALE
  FEMALE
}

// ─────────────────────────────────────────────
// RBAC — Role / Permission / RolePermission
// Role IDs are slugs (STUDENT, INSTRUCTOR, DOJO_MANAGER, DOJO_OWNER, ADMIN)
// seeded by the SQL migration.
// ─────────────────────────────────────────────

model Role {
  id            String  @id // slug
  displayName   String  @map("display_name")
  displayNameBn String? @map("display_name_bn")
  description   String?

  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("roles")
}

model Permission {
  id          String  @id // slug e.g. "members.read.own_dojo"
  resource    String // "members" | "gradings" | ...
  action      String // "read" | "write" | "approve" | ...
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// USERS  (mirrors auth.users via id)
// Shared profile fields for every authenticated user. Role-specific
// data lives in the matching role table (students / instructors / etc).
// ─────────────────────────────────────────────

model User {
  id                 String  @id @db.Uuid // = auth.users.id
  // Supabase auth email. Real for admins (used for password reset); synthetic
  // `{uuid}@members.jkabangladesh.com` for non-admins so a family can share
  // one real email across many accounts. Always unique — Supabase requires it.
  email              String  @unique
  // Real contact email used for notifications. Optional and non-unique — a
  // parent's inbox can appear on multiple children's accounts.
  contactEmail       String? @map("contact_email")
  phone              String?
  fullName           String  @map("full_name")
  avatarUrl          String? @map("avatar_url")
  bio                String?
  roleId             String  @default("STUDENT") @map("role_id")
  isActive           Boolean @default(true) @map("is_active")
  memberNumber       String? @unique @map("member_number")
  // Set when a Dojo Head creates the account with a temporary password —
  // the portal layout redirects the user to /set-password until it clears.
  mustChangePassword Boolean @default(false) @map("must_change_password")

  role        Role         @relation(fields: [roleId], references: [id])
  profile     Profile?
  student     Student?
  instructor  Instructor?
  dojoManager DojoManager?
  dojoOwner   DojoOwner?
  admin       Admin?

  notifications             Notification[]
  orders                    ShopOrder[]
  eventRegistrations        EventRegistration[]
  eventCheckIns             EventRegistration[]      @relation("EventCheckIns")
  eventsPosted              Event[]                  @relation("EventsPosted")
  announcementsPosted       Announcement[]           @relation("AnnouncementsPosted")
  dojoSalesAsBuyer          DojoSale[]               @relation("DojoSaleBuyer")
  dojoSalesSold             DojoSale[]               @relation("DojoSaleSeller")
  achievementsAwarded       StudentAchievement[]     @relation("StudentAchievementsAwarded")
  tournamentEntries         TournamentParticipant[]  @relation("TournamentEntries")
  transfersDojoActed        StudentTransferRequest[] @relation("TransferDojoActor")
  transfersAdminActed       StudentTransferRequest[] @relation("TransferAdminActor")
  transfersNewDojoActed     StudentTransferRequest[] @relation("TransferNewDojoActor")
  dojoHistoryChanges        StudentDojoHistory[]     @relation("HistoryChangedBy")
  paymentTransactions       PaymentTransaction[]     @relation("UserTransactions")
  dojoOwnerInvitesSent      DojoOwnerInvite[]        @relation("DojoOwnerInvites")
  serviceRequestsDojoActed  ServiceRequest[]         @relation("ServiceRequestDojoActor")
  serviceRequestsAdminActed ServiceRequest[]         @relation("ServiceRequestAdminActor")
  serviceCouponsCreated     ServiceCoupon[]          @relation("ServiceCouponCreator")
  divisionPresetsCreated    DivisionPreset[]         @relation("DivisionPresetsCreated")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([roleId])
  @@map("users")
}

// ─────────────────────────────────────────────
// PROFILE  — shared personal details (1:1 with User)
// ─────────────────────────────────────────────

model Profile {
  id                    String    @id @db.Uuid // = users.id
  dateOfBirth           DateTime? @map("date_of_birth") @db.Date
  gender                Gender?
  bloodGroup            String?   @map("blood_group")
  address               String?
  nationalId            String?   @unique @map("national_id")
  fatherName            String?   @map("father_name")
  motherName            String?   @map("mother_name")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

// ─────────────────────────────────────────────
// STUDENT  — student-specific profile (1:1 with User)
// ─────────────────────────────────────────────

model Student {
  id          String    @id @db.Uuid // = users.id
  currentRank String    @default("White Belt") @map("current_rank")
  joinDate    DateTime  @default(now()) @map("join_date") @db.Timestamptz(6)
  expiryDate  DateTime? @map("expiry_date") @db.Timestamptz(6)
  dojoId      String?   @map("dojo_id") @db.Uuid

  onboardingComplete Boolean          @default(false) @map("onboarding_complete")
  membershipStatus   MembershipStatus @default(PENDING) @map("membership_status")

  // Multi-step joining flow — see JoinStage enum.
  joinStage      JoinStage @default(FEE_UNPAID) @map("join_stage")
  requestedRank  String?   @map("requested_rank") // Rank student picked at signup
  assignedRank   String?   @map("assigned_rank") // Rank the dojo owner confirmed on approval
  pastBeltFeeBDT Int?      @map("past_belt_fee_bdt") // Calculated at approval; null when white belt
  joinPdfUrl     String?   @map("join_pdf_url") // "Bring this to your dojo" printable doc
  joinedAt       DateTime? @map("joined_at") @db.Timestamptz(6)

  user User  @relation(fields: [id], references: [id], onDelete: Cascade)
  dojo Dojo? @relation("DojoStudents", fields: [dojoId], references: [id])

  gradings            Grading[]
  gradingApplications GradingApplication[]
  certificateRequests CertificateRequest[]
  achievements        StudentAchievement[]     @relation("StudentAchievements")
  transferRequests    StudentTransferRequest[]
  serviceRequests     ServiceRequest[]
  dojoHistory         StudentDojoHistory[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([dojoId])
  @@map("students")
}

// ─────────────────────────────────────────────
// INSTRUCTOR  — 1:1 with User
// ─────────────────────────────────────────────

model Instructor {
  id         String   @id @db.Uuid // = users.id
  dojoId     String?  @map("dojo_id") @db.Uuid
  joinedDate DateTime @default(now()) @map("joined_date") @db.Timestamptz(6)
  bio        String?

  user User  @relation(fields: [id], references: [id], onDelete: Cascade)
  dojo Dojo? @relation("DojoInstructors", fields: [dojoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([dojoId])
  @@map("instructors")
}

// ─────────────────────────────────────────────
// DOJO MANAGER  — 1:1 with User
// ─────────────────────────────────────────────

model DojoManager {
  id     String  @id @db.Uuid // = users.id
  dojoId String? @map("dojo_id") @db.Uuid

  user User  @relation(fields: [id], references: [id], onDelete: Cascade)
  dojo Dojo? @relation("DojoManagers", fields: [dojoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([dojoId])
  @@map("dojo_managers")
}

// ─────────────────────────────────────────────
// DOJO OWNER  — 1:1 with User, 1:1 with Dojo
// Replaces the partial unique index `members_one_owner_per_dojo` with
// a hard UNIQUE constraint on dojo_id.
// ─────────────────────────────────────────────

model DojoOwner {
  id           String  @id @db.Uuid // = users.id
  dojoId       String? @unique @map("dojo_id") @db.Uuid
  signatureUrl String? @map("signature_url")

  user User  @relation(fields: [id], references: [id], onDelete: Cascade)
  dojo Dojo? @relation("DojoOwner", fields: [dojoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("dojo_owners")
}

// ─────────────────────────────────────────────
// ADMIN  — 1:1 with User
// ─────────────────────────────────────────────

model Admin {
  id    String  @id @db.Uuid // = users.id
  scope String? // optional admin scope tag

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admins")
}

// ─────────────────────────────────────────────
// BELT RANKS
// ─────────────────────────────────────────────

model BeltRank {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String  @unique
  kyuDan     String? @map("kyu_dan")
  colorHex   String? @map("color_hex")
  orderIndex Int     @unique @map("order_index")

  certificatePrice Decimal? @map("certificate_price") @db.Decimal(10, 2)

  gradingsFrom        Grading[]            @relation("GradingFromRank")
  gradingsTo          Grading[]            @relation("GradingToRank")
  gradingEvents       GradingEvent[]       @relation("EventTargetRank")
  gradingApplications GradingApplication[] @relation("AppTargetRank")
  minRankEvents       Event[]              @relation("EventMinRank")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("belt_ranks")
}

// ─────────────────────────────────────────────
// DOJOS
// ─────────────────────────────────────────────

model Dojo {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  shortName String? @map("short_name")
  address   String?
  city      String?
  latitude  Float?
  longitude Float?
  phone     String?
  email     String?
  isActive  Boolean @default(true) @map("is_active")

  annualFee  Decimal?  @map("annual_fee") @db.Decimal(10, 2)
  expiryDate DateTime? @map("expiry_date") @db.Timestamptz(6)

  renewalOrders ShopOrder[] @relation("DojoRenewalOrders")

  certificateOrders   ShopOrder[]          @relation("DojoCertificateOrders")
  certificateRequests CertificateRequest[]

  ownerSignatureUrl String? @map("owner_signature_url")
  logoUrl           String? @map("logo_url")

  // Feature keys the JKA admin has explicitly locked for this dojo. Union
  // with the automatic milestone locks (dojos with <30 active students get
  // certificates/announcements/transfers/invite-staff auto-locked).
  // Values are from lib/dojo/feature-locks.ts FEATURE_KEYS.
  lockedFeatures String[] @default([]) @map("locked_features")

  // Active-student count this dojo must reach before the milestone-gated
  // features (certificates, announcements, transfers, invite-staff)
  // auto-unlock. Defaults to 0 (features open immediately).
  studentMilestone Int @default(0) @map("student_milestone")

  students        Student[]                @relation("DojoStudents")
  instructors     Instructor[]             @relation("DojoInstructors")
  managers        DojoManager[]            @relation("DojoManagers")
  owner           DojoOwner?               @relation("DojoOwner")
  application     DojoApplication?         @relation("DojoApplicationDojo")
  events          Event[]                  @relation("DojoEvents")
  announcements   Announcement[]           @relation("DojoAnnouncements")
  inventoryItems  DojoInventoryItem[]      @relation("DojoInventoryItems")
  sales           DojoSale[]               @relation("DojoSales")
  transfersOut    StudentTransferRequest[] @relation("TransferFromDojo")
  transfersIn     StudentTransferRequest[] @relation("TransferToDojo")
  historyFrom     StudentDojoHistory[]     @relation("HistoryFromDojo")
  historyTo       StudentDojoHistory[]     @relation("HistoryToDojo")
  serviceRequests ServiceRequest[]         @relation("ServiceRequestDojo")
  serviceCoupons  ServiceCoupon[]          @relation("ServiceCouponDojo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("dojos")
}

// ─────────────────────────────────────────────
// DOJO ENLISTMENT APPLICATIONS
// ─────────────────────────────────────────────

enum DojoApplicationStatus {
  PENDING_PAYMENT
  PAID
  APPROVED
  REJECTED
}

model DojoApplication {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String? @map("user_id") @db.Uuid // Supabase auth.users id of the owner

  dojoName    String    @map("dojo_name")
  logoUrl     String?   @map("logo_url")
  email       String
  phone       String
  contactName String    @map("contact_name")
  contactRole String    @map("contact_role")
  contactRank String?   @map("contact_rank")
  contactDob  DateTime? @map("contact_dob") @db.Date

  address   String
  latitude  Float?
  longitude Float?

  interiorUrls String[] @default([]) @map("interior_urls")
  trainers     Json     @default("[]")

  status    DojoApplicationStatus @default(PENDING_PAYMENT)
  paymentId String?               @map("payment_id")

  dojoId String? @unique @map("dojo_id") @db.Uuid
  dojo   Dojo?   @relation("DojoApplicationDojo", fields: [dojoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
  @@map("dojo_applications")
}

// ─────────────────────────────────────────────
// DOJO OWNER INVITES
//
// Admin-issued invitations to prospective Dojo Owners. The invite is a
// promise sent by email — the invitee completes /enlist-dojo/signup on
// their own; `acceptedAt` is stamped when a matching email finishes that
// flow. Distinct from `dojo_applications`, which is the payload the
// invitee submits.
// ─────────────────────────────────────────────

model DojoOwnerInvite {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String    @unique
  fullName    String?   @map("full_name")
  invitedById String    @map("invited_by_id") @db.Uuid
  invitedAt   DateTime  @default(now()) @map("invited_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)

  invitedBy User @relation("DojoOwnerInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([invitedById])
  @@map("dojo_owner_invites")
}

// ─────────────────────────────────────────────
// GRADING EVENTS
// ─────────────────────────────────────────────

model GradingEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  eventDate    DateTime @map("event_date") @db.Timestamptz(6)
  location     String?
  targetRankId String?  @map("target_rank_id") @db.Uuid
  isOpen       Boolean  @default(true) @map("is_open")
  notes        String?

  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?   @map("cancel_reason")

  resultsPublishedAt DateTime? @map("results_published_at") @db.Timestamptz(6)

  targetRank   BeltRank?            @relation("EventTargetRank", fields: [targetRankId], references: [id])
  gradings     Grading[]
  applications GradingApplication[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("grading_events")
}

// ─────────────────────────────────────────────
// GRADING APPLICATIONS — students only
// ─────────────────────────────────────────────

model GradingApplication {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String            @map("student_id") @db.Uuid
  gradingEventId String?           @map("grading_event_id") @db.Uuid
  targetRankId   String?           @map("target_rank_id") @db.Uuid
  status         ApplicationStatus @default(SUBMITTED)
  notes          String?
  declineReason  String?           @map("decline_reason")
  appliedAt      DateTime          @default(now()) @map("applied_at") @db.Timestamptz(6)

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradingEvent GradingEvent? @relation(fields: [gradingEventId], references: [id], onDelete: Cascade)
  targetRank   BeltRank?     @relation("AppTargetRank", fields: [targetRankId], references: [id])

  @@index([studentId])
  @@index([gradingEventId])
  @@map("grading_applications")
}

// ─────────────────────────────────────────────
// GRADINGS — students only
// ─────────────────────────────────────────────

model Grading {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  gradingEventId String?       @map("grading_event_id") @db.Uuid
  fromRankId     String?       @map("from_rank_id") @db.Uuid
  toRankId       String?       @map("to_rank_id") @db.Uuid
  result         GradingResult @default(PASSED)
  marks          Int?          @db.SmallInt
  certificateUrl String?       @map("certificate_url")
  notes          String?

  /// True when marks >= 80 promoted the student two ranks instead of one.
  /// See lib/grading-promotion.ts — toRankId already holds the final rank.
  isDoublePromotion Boolean @default(false) @map("is_double_promotion")

  /// Post-publish pipeline stage. Only PASSED rows are meant to advance.
  pipelineStage     GradingPipelineStage @default(QUALIFIED) @map("pipeline_stage")
  verifiedAt        DateTime?            @map("verified_at") @db.Timestamptz(6)
  verifiedByUserId  String?              @map("verified_by_user_id") @db.Uuid
  submittedAt       DateTime?            @map("submitted_at") @db.Timestamptz(6)
  submittedByUserId String?              @map("submitted_by_user_id") @db.Uuid

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradingEvent GradingEvent? @relation(fields: [gradingEventId], references: [id])
  fromRank     BeltRank?     @relation("GradingFromRank", fields: [fromRankId], references: [id])
  toRank       BeltRank?     @relation("GradingToRank", fields: [toRankId], references: [id])

  certificateRequests CertificateRequest[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("gradings")
}

// ─────────────────────────────────────────────
// CERTIFICATE REQUESTS — issued for students
// ─────────────────────────────────────────────

model CertificateRequest {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gradingId      String                   @map("grading_id") @db.Uuid
  studentId      String                   @map("student_id") @db.Uuid
  dojoId         String                   @map("dojo_id") @db.Uuid
  orderId        String?                  @map("order_id") @db.Uuid
  status         CertificateRequestStatus @default(PENDING_PAYMENT)
  price          Decimal                  @db.Decimal(10, 2)
  certificateUrl String?                  @map("certificate_url")
  failureReason  String?                  @map("failure_reason")

  memberName String  @map("member_name")
  fatherName String? @map("father_name")
  motherName String? @map("mother_name")
  rankName   String  @map("rank_name")

  grading Grading    @relation(fields: [gradingId], references: [id], onDelete: Cascade)
  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dojo    Dojo       @relation(fields: [dojoId], references: [id])
  order   ShopOrder? @relation("OrderCertificates", fields: [orderId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([gradingId])
  @@index([dojoId])
  @@index([orderId])
  @@index([status])
  @@map("certificate_requests")
}

// ─────────────────────────────────────────────
// SYSTEM SETTINGS — singleton
// ─────────────────────────────────────────────

model SystemSettings {
  id                 String  @id @default("default")
  adminSignatureUrl  String? @map("admin_signature_url")
  adminSignerName    String? @map("admin_signer_name")
  adminSignerTitle   String? @map("admin_signer_title")
  certificateLogoUrl String? @map("certificate_logo_url")

  // Subscription / affiliation fees (BDT). Editable from the admin
  // subscriptions page; NULL means "fall back to the built-in default".
  dojoEnlistmentFeeBDT  Decimal? @map("dojo_enlistment_fee_bdt") @db.Decimal(10, 2)
  dojoRenewalFeeBDT     Decimal? @map("dojo_renewal_fee_bdt") @db.Decimal(10, 2)
  membershipFeeBDT      Decimal? @map("membership_fee_bdt") @db.Decimal(10, 2)
  transferFeeBDT        Decimal? @map("transfer_fee_bdt") @db.Decimal(10, 2)
  pastBeltFeePerRankBDT Decimal? @map("past_belt_fee_per_rank_bdt") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

// ─────────────────────────────────────────────
// EVENTS — posted by any user (admin or dojo owner)
// ─────────────────────────────────────────────

model Event {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  eventDate   DateTime      @map("event_date") @db.Timestamptz(6)
  location    String?
  imageUrl    String?       @map("image_url")
  isPublished Boolean       @default(false) @map("is_published")
  maxCapacity Int?          @map("max_capacity")
  category    EventCategory @default(OTHER)

  attachmentUrl  String?         @map("attachment_url")
  attachmentType AttachmentType? @map("attachment_type")

  // Premium ticketing — ticketPrice is required (BDT) when isPremium is true.
  isPremium   Boolean  @default(false) @map("is_premium")
  ticketPrice Decimal? @map("ticket_price") @db.Decimal(10, 2)

  // Discount percentage (0–100, 2dp) applied to the ticket price for
  // signed-in JKA members with an ACTIVE membership. Zero = no discount.
  memberDiscountPercent Decimal @default(0) @map("member_discount_percent") @db.Decimal(5, 2)

  // Optional discount applied when a participant selects 2 or more
  // divisions in this event. `multiDivisionDiscountType` = "PERCENT" reads
  // the value as a 0–100 percentage; "FIXED" reads it as a flat BDT
  // amount subtracted from the division subtotal. Zero value = no
  // multi-division discount regardless of type.
  multiDivisionDiscountType    String  @default("PERCENT") @map("multi_division_discount_type")
  multiDivisionDiscountPercent Decimal @default(0) @map("multi_division_discount_percent") @db.Decimal(10, 2)

  // Optional participation gates.
  minAge          Int?                 @map("min_age")
  minRankId       String?              @map("min_rank_id") @db.Uuid
  participantType EventParticipantType @default(PUBLIC) @map("participant_type")

  postedById String? @map("posted_by_id") @db.Uuid
  dojoId     String? @map("dojo_id") @db.Uuid

  registrations    EventRegistration[]
  postedBy         User?               @relation("EventsPosted", fields: [postedById], references: [id])
  dojo             Dojo?               @relation("DojoEvents", fields: [dojoId], references: [id])
  minRank          BeltRank?           @relation("EventMinRank", fields: [minRankId], references: [id], onDelete: SetNull)
  tournamentDetail TournamentDetail?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isPublished, eventDate])
  @@index([category])
  @@map("events")
}

// ─────────────────────────────────────────────
// TOURNAMENT DETAIL — 1:1 with Event when category = TOURNAMENT
// ─────────────────────────────────────────────
// Kata vs Kumite is set here, along with the subset of WKF divisions the
// admin has enabled for this specific tournament. Division codes live in
// lib/tournaments/divisions.ts — they are stable identifiers, not FKs.

model TournamentDetail {
  eventId              String                @id @map("event_id") @db.Uuid
  // Legacy single-type flag — kept for older rows and reporting. New writes
  // also populate `enabledTypes`, and the participant flow reads from that.
  eventType            TournamentEventType   @map("event_type")
  // 1 or 2 of KATA/KUMITE. An event may run both types.
  enabledTypes         TournamentEventType[] @map("enabled_types")
  enabledDivisions     String[]              @map("enabled_divisions")
  // Admin-added categories not in the WKF preset. Shape:
  //   { code: string, label: string, eventType: 'KATA'|'KUMITE', isTeam: boolean }[]
  customDivisions      Json?                 @map("custom_divisions")
  registrationDeadline DateTime?             @map("registration_deadline") @db.Timestamptz(6)
  weighInDate          DateTime?             @map("weigh_in_date") // KUMITE only @db.Timestamptz(6)
  rulesUrl             String?               @map("rules_url")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tournament_details")
}

// ─────────────────────────────────────────────
// ANNOUNCEMENTS — posted by any user
// ─────────────────────────────────────────────

model Announcement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  body        String?
  link        String?
  isPublished Boolean  @default(true) @map("is_published")
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  attachmentUrl  String?         @map("attachment_url")
  attachmentType AttachmentType? @map("attachment_type")

  postedById String? @map("posted_by_id") @db.Uuid
  dojoId     String? @map("dojo_id") @db.Uuid

  postedBy User? @relation("AnnouncementsPosted", fields: [postedById], references: [id])
  dojo     Dojo? @relation("DojoAnnouncements", fields: [dojoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isPublished, publishedAt])
  @@map("announcements")
}

// ─────────────────────────────────────────────
// DIVISION PRESETS — reusable event division templates
// ─────────────────────────────────────────────
// Admins save the current form's divisions block (name + gates + fees) as
// a preset they can import back into future event forms. `divisions` is
// the same shape as TournamentDetail.customDivisions (see
// lib/tournaments/divisions.ts).

model DivisionPreset {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  divisions   Json

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("DivisionPresetsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdById, createdAt])
  @@map("division_presets")
}

// ─────────────────────────────────────────────
// EVENT REGISTRATIONS — any user, or guest
// ─────────────────────────────────────────────

model EventRegistration {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  userId     String? @map("user_id") @db.Uuid
  guestName  String? @map("guest_name")
  guestEmail String? @map("guest_email")
  guestPhone String? @map("guest_phone")

  qrToken String @unique @map("qr_token")

  // Premium-event ticket payment. Null on free events; PENDING until the
  // SSLCommerz payment settles, then PAID.
  paymentStatus  PaymentStatus? @map("payment_status")
  // When a tournament participant pays for multiple divisions in one submit,
  // every row in the group shares this id. The gateway session runs on the
  // primary row's id + summed amount; markRegistrationPaid fans PAID out to
  // the siblings.
  paymentGroupId String?        @map("payment_group_id") @db.Uuid
  amountDue      Decimal?       @map("amount_due") @db.Decimal(10, 2)
  paidAt         DateTime?      @map("paid_at") @db.Timestamptz(6)
  transactionId  String?        @map("transaction_id")

  // Gate answers collected at registration time.
  guestDateOfBirth     DateTime? @map("guest_date_of_birth") @db.Date
  parentOfMemberNumber String?   @map("parent_of_member_number")

  // ── Tournament-only fields (null on non-tournament events) ─────────────
  // divisionCode references lib/tournaments/divisions.ts. gender + weight
  // are captured on the registration row (rather than the profile) because
  // weight in particular varies over time and is measured at weigh-in.
  divisionCode    String?  @map("division_code")
  entrantGender   Gender?  @map("entrant_gender")
  entrantWeightKg Decimal? @map("entrant_weight_kg") @db.Decimal(5, 2)
  entrantBeltRank String?  @map("entrant_belt_rank")
  entrantDojoName String?  @map("entrant_dojo_name") // free-text for guests
  coachName       String?  @map("coach_name")

  // Team kata — teammates stored as JSON array of { name, memberNumber? }.
  teamName  String? @map("team_name")
  teammates Json?   @map("teammates")

  // Minor guardian block — required when entrant is under 18 on event date.
  guardianName    String?  @map("guardian_name")
  guardianPhone   String?  @map("guardian_phone")
  guardianConsent Boolean? @map("guardian_consent")

  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")

  // Optional profile image the participant uploaded — shown on their
  // participation card. Cloudinary URL.
  profileImageUrl String? @map("profile_image_url")

  // Snapshot of opt-in fees the entrant picked for THIS division row:
  // [{ id, label, amountBdt }]. Snapshotting labels/amounts avoids drift
  // if the admin later renames or reprices a fee.
  selectedOptionalFees Json? @map("selected_optional_fees")

  checkedInAt       DateTime? @map("checked_in_at") @db.Timestamptz(6)
  checkedInByUserId String?   @map("checked_in_by_user_id") @db.Uuid

  event        Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkedInBy  User?                @relation("EventCheckIns", fields: [checkedInByUserId], references: [id])
  transactions PaymentTransaction[] @relation("EventRegistrationTransactions")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventId, checkedInAt])
  @@index([eventId, divisionCode])
  @@map("event_registrations")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS — any user
// ─────────────────────────────────────────────

model Notification {
  id      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String           @map("user_id") @db.Uuid
  title   String
  message String
  type    NotificationType @default(INFO)
  isRead  Boolean          @default(false) @map("is_read")
  link    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notifications")
}

// ─────────────────────────────────────────────
// SHOP PRODUCTS
// ─────────────────────────────────────────────

model ShopProduct {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  stock       Int     @default(0)
  imageUrl    String? @map("image_url")
  category    String?
  isActive    Boolean @default(true) @map("is_active")

  // Sizing — when hasSizes is true, customers must pick one of `sizes` before
  // adding to cart. Kept as a plain text array so admins can use any labels
  // (S/M/L, 32/34/36, kids/adult, etc.).
  hasSizes Boolean  @default(false) @map("has_sizes")
  sizes    String[] @default([])

  // Discount percentage (0–100) applied to signed-in JKA members with an
  // ACTIVE membership. Zero = no discount.
  memberDiscountPercent Int @default(0) @map("member_discount_percent")

  orderItems    ShopOrderItem[]
  dojoInventory DojoInventoryItem[] @relation("InventoryProduct")
  dojoSaleItems DojoSaleItem[]      @relation("SaleItemProduct")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("shop_products")
}

// ─────────────────────────────────────────────
// DOJO INVENTORY
// ─────────────────────────────────────────────

model DojoInventoryItem {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dojoId         String  @map("dojo_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantityOnHand Int     @default(0) @map("quantity_on_hand")
  unitPrice      Decimal @map("unit_price") @db.Decimal(10, 2)

  dojo    Dojo        @relation("DojoInventoryItems", fields: [dojoId], references: [id], onDelete: Cascade)
  product ShopProduct @relation("InventoryProduct", fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([dojoId, productId])
  @@index([dojoId])
  @@map("dojo_inventory_items")
}

// ─────────────────────────────────────────────
// DOJO SALES (member receipts)
// ─────────────────────────────────────────────

model DojoSale {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dojoId        String  @map("dojo_id") @db.Uuid
  receiptNo     String  @map("receipt_no")
  buyerUserId   String? @map("buyer_user_id") @db.Uuid
  buyerName     String  @map("buyer_name")
  soldByUserId  String? @map("sold_by_user_id") @db.Uuid
  soldByName    String? @map("sold_by_name")
  subtotal      Decimal @db.Decimal(10, 2)
  discount      Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)
  paymentMethod String? @map("payment_method")
  notes         String?

  dojo   Dojo           @relation("DojoSales", fields: [dojoId], references: [id], onDelete: Cascade)
  buyer  User?          @relation("DojoSaleBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  soldBy User?          @relation("DojoSaleSeller", fields: [soldByUserId], references: [id], onDelete: SetNull)
  items  DojoSaleItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([dojoId, receiptNo])
  @@index([dojoId, createdAt])
  @@index([buyerUserId])
  @@map("dojo_sales")
}

model DojoSaleItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId      String  @map("sale_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  productName String  @map("product_name")
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(10, 2)

  sale    DojoSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product ShopProduct @relation("SaleItemProduct", fields: [productId], references: [id])

  @@index([saleId])
  @@map("dojo_sale_items")
}

// ─────────────────────────────────────────────
// SHOP ORDERS — any user
// ─────────────────────────────────────────────

model ShopOrder {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String?               @map("user_id") @db.Uuid
  paymentStatus      PaymentStatus         @default(PENDING) @map("payment_status")
  paymentMethod      String?               @map("payment_method")
  total              Decimal               @db.Decimal(10, 2)
  currency           String                @default("BDT")
  transactionId      String?               @unique @map("transaction_id")
  includesMembership Boolean               @default(false) @map("includes_membership")
  membershipFee      Decimal?              @map("membership_fee") @db.Decimal(10, 2)
  fulfillmentStatus  ShopFulfillmentStatus @default(PREPARING) @map("fulfillment_status")
  notes              String?

  // Guest shop-checkout fields — used when there is no logged-in user.
  guestName    String? @map("guest_name")
  guestEmail   String? @map("guest_email")
  guestPhone   String? @map("guest_phone")
  guestAddress String? @map("guest_address")
  isGuestOrder Boolean @default(false) @map("is_guest_order")

  dojoId              String? @map("dojo_id") @db.Uuid
  includesDojoRenewal Boolean @default(false) @map("includes_dojo_renewal")

  includesCertificates Boolean @default(false) @map("includes_certificates")
  certDojoId           String? @map("cert_dojo_id") @db.Uuid

  includesTransferRequest Boolean @default(false) @map("includes_transfer_request")

  // Past-belt catch-up fee paid when a new student is accepted at a rank
  // above White Belt. Consumed by the joining flow — see JoinStage.
  includesPastBeltFee Boolean @default(false) @map("includes_past_belt_fee")

  // Generic service request (Kyu/Dan Conversion, admin-added services).
  includesServiceRequest Boolean @default(false) @map("includes_service_request")

  user                User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  dojo                Dojo?                   @relation("DojoRenewalOrders", fields: [dojoId], references: [id])
  certDojo            Dojo?                   @relation("DojoCertificateOrders", fields: [certDojoId], references: [id])
  orderItems          ShopOrderItem[]
  certificateRequests CertificateRequest[]    @relation("OrderCertificates")
  transferRequest     StudentTransferRequest? @relation("TransferOrder")
  serviceRequest      ServiceRequest?         @relation("ServiceRequestOrder")
  transactions        PaymentTransaction[]    @relation("OrderTransactions")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("shop_orders")
}

// ─────────────────────────────────────────────
// SHOP ORDER ITEMS
// ─────────────────────────────────────────────

model ShopOrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  size      String?

  order   ShopOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ShopProduct @relation(fields: [productId], references: [id])

  @@map("shop_order_items")
}

// ─────────────────────────────────────────────
// TOURNAMENTS
// ─────────────────────────────────────────────

model Tournament {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  date        DateTime @db.Timestamptz(6)
  location    String?
  isPublished Boolean  @default(false) @map("is_published")

  participants TournamentParticipant[]
  matches      TournamentMatch[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tournaments")
}

// ─────────────────────────────────────────────
// TOURNAMENT PARTICIPANTS — any user (students, admins-as-competitors)
// ─────────────────────────────────────────────

model TournamentParticipant {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId String  @map("tournament_id") @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  category     String?
  weightClass  String? @map("weight_class")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation("TournamentEntries", fields: [userId], references: [id], onDelete: Cascade)

  matchesAsP1 TournamentMatch[] @relation("MatchParticipant1")
  matchesAsP2 TournamentMatch[] @relation("MatchParticipant2")
  matchesWon  TournamentMatch[] @relation("MatchWinner")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tournamentId, userId])
  @@map("tournament_participants")
}

// ─────────────────────────────────────────────
// TOURNAMENT MATCHES
// ─────────────────────────────────────────────

model TournamentMatch {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId   String  @map("tournament_id") @db.Uuid
  participant1Id String? @map("participant1_id") @db.Uuid
  participant2Id String? @map("participant2_id") @db.Uuid
  winnerId       String? @map("winner_id") @db.Uuid
  round          Int?
  matchOrder     Int?    @map("match_order")
  notes          String?

  tournament   Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant1 TournamentParticipant? @relation("MatchParticipant1", fields: [participant1Id], references: [id])
  participant2 TournamentParticipant? @relation("MatchParticipant2", fields: [participant2Id], references: [id])
  winner       TournamentParticipant? @relation("MatchWinner", fields: [winnerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("tournament_matches")
}

// ─────────────────────────────────────────────
// ACHIEVEMENTS
// ─────────────────────────────────────────────

model Achievement {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String          @unique
  name          String
  nameBn        String?         @map("name_bn")
  description   String
  descriptionBn String?         @map("description_bn")
  icon          String
  tier          AchievementTier @default(COMMON)
  rule          AchievementRule @default(MANUAL)
  threshold     Int?
  orderIndex    Int             @default(0) @map("order_index")
  isActive      Boolean         @default(true) @map("is_active")

  studentAchievements StudentAchievement[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tier, orderIndex])
  @@map("achievements")
}

model StudentAchievement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  achievementId   String   @map("achievement_id") @db.Uuid
  unlockedAt      DateTime @default(now()) @map("unlocked_at") @db.Timestamptz(6)
  progress        Int      @default(0)
  awardedByUserId String?  @map("awarded_by_user_id") @db.Uuid
  note            String?

  student     Student     @relation("StudentAchievements", fields: [studentId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  awardedBy   User?       @relation("StudentAchievementsAwarded", fields: [awardedByUserId], references: [id], onDelete: SetNull)

  @@unique([studentId, achievementId])
  @@index([studentId])
  @@index([achievementId])
  @@map("student_achievements")
}

// ─────────────────────────────────────────────
// STUDENT DOJO TRANSFER REQUESTS
// ─────────────────────────────────────────────

model StudentTransferRequest {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String @map("student_id") @db.Uuid
  fromDojoId String @map("from_dojo_id") @db.Uuid
  toDojoId   String @map("to_dojo_id") @db.Uuid

  status       StudentTransferStatus       @default(PENDING_PAYMENT)
  dojoDecision StudentTransferDojoDecision @default(PENDING) @map("dojo_decision")

  reason    String?
  dojoNote  String? @map("dojo_note")
  adminNote String? @map("admin_note")

  fee            Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  finalAmount    Decimal? @map("final_amount") @db.Decimal(10, 2)
  couponCode     String?  @map("coupon_code")

  orderId String? @unique @map("order_id") @db.Uuid

  paidAt           DateTime? @map("paid_at") @db.Timestamptz(6)
  dojoActedAt      DateTime? @map("dojo_acted_at") @db.Timestamptz(6)
  dojoActedById    String?   @map("dojo_acted_by_id") @db.Uuid
  adminActedAt     DateTime? @map("admin_acted_at") @db.Timestamptz(6)
  adminActedById   String?   @map("admin_acted_by_id") @db.Uuid
  newDojoActedAt   DateTime? @map("new_dojo_acted_at") @db.Timestamptz(6)
  newDojoActedById String?   @map("new_dojo_acted_by_id") @db.Uuid
  assignedRank     String?   @map("assigned_rank")

  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromDojo       Dojo       @relation("TransferFromDojo", fields: [fromDojoId], references: [id])
  toDojo         Dojo       @relation("TransferToDojo", fields: [toDojoId], references: [id])
  order          ShopOrder? @relation("TransferOrder", fields: [orderId], references: [id], onDelete: SetNull)
  dojoActedBy    User?      @relation("TransferDojoActor", fields: [dojoActedById], references: [id], onDelete: SetNull)
  adminActedBy   User?      @relation("TransferAdminActor", fields: [adminActedById], references: [id], onDelete: SetNull)
  newDojoActedBy User?      @relation("TransferNewDojoActor", fields: [newDojoActedById], references: [id], onDelete: SetNull)

  history StudentDojoHistory[] @relation("HistoryTransferRequest")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([studentId])
  @@index([fromDojoId, status])
  @@index([toDojoId, status])
  @@index([status])
  @@map("student_transfer_requests")
}

// ─────────────────────────────────────────────
// STUDENT DOJO HISTORY  — audit log of dojo changes
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
// PAYMENT TRANSACTIONS — audit log for every gateway attempt
// ─────────────────────────────────────────────

model PaymentTransaction {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Linked domain rows. ShopOrder covers membership / past-belt / cert /
  // dojo-renewal / transfer / shop paths; eventRegistrationId covers event
  // tickets which have their own domain object.
  orderId             String? @map("order_id") @db.Uuid
  eventRegistrationId String? @map("event_registration_id") @db.Uuid
  userId              String? @map("user_id") @db.Uuid

  provider     PaymentProvider          @default(SSLCOMMERZ)
  kind         PaymentTransactionKind
  status       PaymentTransactionStatus @default(PENDING)
  amount       Decimal                  @db.Decimal(10, 2)
  currency     String                   @default("BDT")
  gatewayTxnId String?                  @map("gateway_txn_id")
  reason       String?
  buyerName    String?                  @map("buyer_name")
  buyerEmail   String?                  @map("buyer_email")
  buyerPhone   String?                  @map("buyer_phone")

  order             ShopOrder?         @relation("OrderTransactions", fields: [orderId], references: [id], onDelete: SetNull)
  eventRegistration EventRegistration? @relation("EventRegistrationTransactions", fields: [eventRegistrationId], references: [id], onDelete: SetNull)
  user              User?              @relation("UserTransactions", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([eventRegistrationId])
  @@index([userId])
  @@index([status])
  @@index([kind])
  @@index([createdAt])
  @@map("payment_transactions")
}

model StudentDojoHistory {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId         String  @map("student_id") @db.Uuid
  fromDojoId        String? @map("from_dojo_id") @db.Uuid
  toDojoId          String? @map("to_dojo_id") @db.Uuid
  transferRequestId String? @map("transfer_request_id") @db.Uuid
  changedById       String? @map("changed_by_id") @db.Uuid
  reason            String?

  student         Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromDojo        Dojo?                   @relation("HistoryFromDojo", fields: [fromDojoId], references: [id])
  toDojo          Dojo?                   @relation("HistoryToDojo", fields: [toDojoId], references: [id])
  transferRequest StudentTransferRequest? @relation("HistoryTransferRequest", fields: [transferRequestId], references: [id], onDelete: SetNull)
  changedBy       User?                   @relation("HistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([studentId])
  @@map("student_dojo_history")
}

// ─────────────────────────────────────────────
// SERVICES CATALOG — admin-managed list of purchasable services
// ─────────────────────────────────────────────

model Service {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String  @unique
  name        String
  description String?
  feeBDT      Decimal @map("fee_bdt") @db.Decimal(10, 2)
  isActive    Boolean @default(true) @map("is_active")

  // Handler slug: which client flow to route to. "kyu-dan-conversion" and
  // "generic" are recognized today; more can be added without a migration.
  handler String @default("generic")

  requests ServiceRequest[]
  coupons  ServiceCoupon[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("services")
}

// ─────────────────────────────────────────────
// SERVICE REQUESTS — student submits, dojo approves, admin approves
// ─────────────────────────────────────────────

model ServiceRequest {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  dojoId    String @map("dojo_id") @db.Uuid

  status       ServiceRequestStatus       @default(PENDING_PAYMENT)
  dojoDecision ServiceRequestDojoDecision @default(PENDING) @map("dojo_decision")

  // Free-form request payload (e.g. { requestedRank, currentRank } for
  // kyu-dan conversion). Kept as JSON so admin-added services can carry
  // their own fields without schema churn.
  payload Json @default("{}")

  reason    String?
  dojoNote  String? @map("dojo_note")
  adminNote String? @map("admin_note")

  fee            Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(10, 2)
  finalAmount    Decimal @map("final_amount") @db.Decimal(10, 2)
  couponId       String? @map("coupon_id") @db.Uuid
  couponCode     String? @map("coupon_code")

  orderId String? @unique @map("order_id") @db.Uuid

  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  dojoActedAt    DateTime? @map("dojo_acted_at") @db.Timestamptz(6)
  dojoActedById  String?   @map("dojo_acted_by_id") @db.Uuid
  adminActedAt   DateTime? @map("admin_acted_at") @db.Timestamptz(6)
  adminActedById String?   @map("admin_acted_by_id") @db.Uuid

  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  service      Service        @relation(fields: [serviceId], references: [id])
  dojo         Dojo           @relation("ServiceRequestDojo", fields: [dojoId], references: [id])
  order        ShopOrder?     @relation("ServiceRequestOrder", fields: [orderId], references: [id], onDelete: SetNull)
  coupon       ServiceCoupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  dojoActedBy  User?          @relation("ServiceRequestDojoActor", fields: [dojoActedById], references: [id], onDelete: SetNull)
  adminActedBy User?          @relation("ServiceRequestAdminActor", fields: [adminActedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([studentId])
  @@index([dojoId, status])
  @@index([serviceId, status])
  @@index([status])
  @@map("service_requests")
}

// ─────────────────────────────────────────────
// SERVICE COUPONS — issued by a dojo, redeemed at checkout
// ─────────────────────────────────────────────

model ServiceCoupon {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String    @unique
  dojoId          String    @map("dojo_id") @db.Uuid
  createdById     String    @map("created_by_id") @db.Uuid
  discountPercent Int       @map("discount_percent") // 1-100
  serviceId       String?   @map("service_id") @db.Uuid // null = any service
  usageLimit      Int       @default(1) @map("usage_limit")
  usedCount       Int       @default(0) @map("used_count")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  isActive        Boolean   @default(true) @map("is_active")
  notes           String?

  dojo      Dojo             @relation("ServiceCouponDojo", fields: [dojoId], references: [id], onDelete: Cascade)
  service   Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy User             @relation("ServiceCouponCreator", fields: [createdById], references: [id], onDelete: Cascade)
  requests  ServiceRequest[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([dojoId])
  @@index([serviceId])
  @@map("service_coupons")
}
